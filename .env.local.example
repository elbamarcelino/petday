NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

ZAPI_INSTANCE_ID=your-zapi-instance-id
ZAPI_TOKEN=your-zapi-token
ZAPI_CLIENT_TOKEN=your-zapi-client-token

# Página pública de agendamento (/agendar/[slug])
# Define o nome exibido na página de agendamento
NEXT_PUBLIC_PETSHOP_NOME=Nome da Sua Petshop
# Slug único da sua petshop (ex: bella-petshop → /agendar/bella-petshop)
# Se não definido, qualquer slug funciona (bom para desenvolvimento)
NEXT_PUBLIC_BOOKING_SLUG=sua-petshop
# Chave PIX exibida na tela de sucesso (opcional — se vazio, não aparece nada)
NEXT_PUBLIC_PIX_KEY=
